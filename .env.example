# Copy this file to .env and fill the BOT_TOKEN
# Example:
# BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

BOT_TOKEN=
WEB_APP_URL=https://telegram-bot-krill-lotin-krill-translater.onrender.com

# Remote failover zanjiri. Ishlamagan provider avtomatik keyingisiga o'tadi.
TRANSLATION_PROVIDER_ORDER=lingva,mymemory,simply,libre
TRANSLATION_TIMEOUT=30
TRANSLATION_MIN_INTERVAL=1.2

# MyMemory uchun API key kerak emas. Email ixtiyoriy, limitni oshirishga yordam beradi.
MYMEMORY_EMAIL=

# Lingva uchun API key kerak emas.
LINGVA_API_URL=https://lingva.ml/api/v1
LINGVA_SOURCE_LANGUAGE=auto

# SimplyTranslate public instance.
SIMPLYTRANSLATE_API_URL=https://simplytranslate.org/api/translate
SIMPLYTRANSLATE_ENGINE=google

# Faqat remote LibreTranslate mirrorlar, localhost/Docker emas.
LIBRETRANSLATE_REMOTE_URLS=https://libretranslate.de,https://translate.argosopentech.com
